# ============================================================
# Anvaya-Prajna-AI Environment Configuration
# ============================================================

# App HTTP Port
APP_PORT=8080

# PostgreSQL Configuration
POSTGRES_DB=anvayadb
POSTGRES_USER=anvaya
POSTGRES_PASSWORD=anvaya_secret
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# AI Models (Optional - Domain fallback logic runs deterministically if omitted)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

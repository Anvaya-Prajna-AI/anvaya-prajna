# ============================================================
# Anvaya-Prajna-AI Environment Configuration (.env)
# ============================================================

# Database (PostgreSQL 16)
POSTGRES_DB=anvayadb
POSTGRES_USER=anvaya
POSTGRES_PASSWORD=anvaya_secret
POSTGRES_PORT=5432

# Redis Cache (Redis 7)
REDIS_PORT=6379

# Explain Service Backend
APP_PORT=8080

# Explain Player UI (React Frontend)
PLAYER_PORT=3000

# LiteLLM Unified AI Gateway & Router
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-litellm-master-key
LITELLM_BASE_URL=http://litellm:4000
DEFAULT_MODEL=gpt-4o-mini

# Amazon Bedrock Credentials (for Nova Pro / Nova Lite / Nova Micro)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Google AI Credentials (for Gemini 1.5 Pro / Gemini 1.5 Flash / Gemini 2.0 Flash)
GEMINI_API_KEY=

# Other LLM Provider API Keys (Configure any providers you plan to use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

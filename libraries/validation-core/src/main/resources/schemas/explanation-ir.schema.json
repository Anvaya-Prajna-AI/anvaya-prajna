{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anvaya-prajna.ai/schemas/v1/explanation-ir.schema.json",
  "title": "ExplanationIR",
  "type": "object",
  "required": [
    "schemaVersion",
    "explanationId",
    "questionId",
    "problem",
    "steps"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "explanationId": { "type": "string" },
    "questionId": { "type": "string" },
    "status": { "type": "string" },
    "problem": { "type": "object" },
    "concepts": { "type": "array" },
    "facts": { "type": "array" },
    "steps": { "type": "array" },
    "verification": { "type": "object" },
    "hints": { "type": "array" },
    "misconceptions": { "type": "array" }
  }
}

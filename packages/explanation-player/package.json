{
  "name": "@anvaya-prajna/explanation-player",
  "version": "1.0.0",
  "description": "Student educational explanation player component library for Anvaya-Prajna Explanation IR",
  "type": "module",
  "main": "./dist/explanation-player.umd.cjs",
  "module": "./dist/explanation-player.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/explanation-player.js",
      "require": "./dist/explanation-player.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anvaya-Prajna-AI/anvaya-prajna.git"
  },
  "keywords": [
    "explanation-ir",
    "react",
    "math",
    "education",
    "reasoning-engine"
  ],
  "author": "Anvaya-Prajna Team <dev@anvaya.ai>",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc && vite build --mode lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "preview": "vite preview"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
